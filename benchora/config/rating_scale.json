      "min_threshold": null
    },
    {
      "name": "Strong",
      "color": "#3b82f6",
      "bg_color": "#dbeafe",
      "condition": "Within leader's run-to-run stdev",
      "min_threshold": null
    },
    {
      "name": "Adequate",
      "color": "#f59e0b",
      "bg_color": "#fef3c7",
      "condition": "Score >= 60% of leader",
      "min_threshold": 0.6
    },
    {
      "name": "Weak",
      "color": "#ef4444",
      "bg_color": "#fee2e2",
      "condition": "Score >= 30% of leader",
      "min_threshold": 0.3
    },
    {
      "name": "Not viable",
      "color": "#6b7280",
      "bg_color": "#f3f4f6",
      "condition": "Score < 30% of leader OR structural failure",
      "min_threshold": 0.0
    }
  ],
  "structural_failure_override": true,
  "structural_failure_conditions": [
    "component_refusal: gate FAIL + >=3 model guardrail refusals in same component",
