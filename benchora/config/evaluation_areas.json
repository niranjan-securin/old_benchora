{
  "version": 1,
  "areas": [
    {
      "id": 1,
      "name": "Recon & Attack Surface",
      "key": "1_recon",
      "components": ["crawler", "attack_surface_discovery"],
      "grading_track": "gt_based",
      "gt_file": "endpoints.json",
      "primary_artifacts": ["crawl_surface.json", "surface.json"],
      "metrics": ["tp", "unmatched", "fn", "precision", "recall", "f1"],
      "primary_metric": "recall",
      "structural_test_case_file": "area1_surface_coverage.json",
      "weight": 1.0,
      "description": "Endpoint discovery coverage against known attack surface"
    },
    {
      "id": 2,
      "name": "Live Application Interaction",
      "key": "2_interaction",
      "components": ["crawler"],
      "grading_track": "test_case",
      "test_case_file": "area2_interaction.json",
      "primary_artifacts": ["session_context.json", "probe_artifacts.json"],
      "metrics": ["pass_rate"],
      "primary_metric": "pass_rate",
      "weight": 1.0,
      "description": "Authenticated crawl quality, role coverage, probe depth"
    },
    {
      "id": 3,
      "name": "SAST",
      "key": "3_sast",
      "components": ["sast"],
      "grading_track": "test_case",
      "test_case_file": "sast.json",
      "primary_artifacts": ["sast_findings.jsonl", "sbom.cdx.json"],
      "metrics": ["pass_rate"],
      "primary_metric": "pass_rate",
      "weight": 1.0,
      "description": "White-box taint path detection and SBOM completeness"
    },
    {
      "id": 4,
      "name": "Vulnerability Analysis (DAST)",
      "key": "4_vuln_analysis",
      "components": ["vulnerability_discovery"],
      "grading_track": "gt_based",
      "gt_file": "vulns.json",
      "primary_artifacts": ["findings.jsonl"],
      "metrics": ["tp", "unmatched", "fn", "precision", "recall", "f1", "owasp_breadth"],
      "primary_metric": "f1",
      "structural_test_case_file": "area4_finding_accuracy.json",
      "weight": 1.0,
      "description": "Vulnerability detection precision and recall against ground truth"
    },
    {
      "id": 5,
      "name": "Exploitation & PoC",
      "key": "5_exploitation",
      "components": ["vulnerability_exploitation"],
      "grading_track": "gt_based",
      "gt_file": "vulns.json",
      "gt_filter": "exploitable",
      "primary_artifacts": ["exploits.jsonl"],
      "metrics": ["exploit_rate", "mean_depth"],
      "primary_metric": "exploit_rate",
      "structural_test_case_file": "area5_exploitation.json",
      "weight": 1.0,
      "description": "PoC reproduction rate against exploitable ground truth vulns"
    },
    {
      "id": 6,
      "name": "Attack Path",
      "key": "6_attack_path",
      "components": ["vulnerability_chaining"],
      "grading_track": "test_case",
      "test_case_file": "area6_attack_path.json",
      "primary_artifacts": ["attack_chain.json"],
      "metrics": ["pass_rate"],
      "primary_metric": "pass_rate",
      "weight": 1.0,
      "description": "Attack chain discovery, depth, and validity"
    },
    {
      "id": 7,
      "name": "Business Logic & Research",
      "key": "7_business_logic",
      "components": ["hacker", "cross_app"],
      "grading_track": "test_case",
      "test_case_file": "area7_business_logic.json",
      "primary_artifacts": ["hacker_findings.jsonl", "cross_app_findings.jsonl"],
      "metrics": ["pass_rate"],
      "primary_metric": "pass_rate",
      "weight": 1.0,
      "description": "Novel finding discovery beyond WSTG, creative pentesting"
    },
    {
      "id": 8,
      "name": "Reporting & Evidence",
      "key": "8_reporting",
      "components": ["reporting"],
      "grading_track": "test_case",
      "test_case_file": "area8_reporting.json",
      "primary_artifacts": ["scored-findings.jsonl", "report.md"],
      "metrics": ["pass_rate"],
      "primary_metric": "pass_rate",
      "weight": 1.0,
      "description": "Report completeness, evidence quality, CVSS/SSVC accuracy"
    },
    {
      "id": 9,
      "name": "Operational Reliability",
      "key": "9_reliability",
      "components": ["_all"],
      "grading_track": "computed",
      "primary_artifacts": [],
      "metrics": ["refusal_rate", "schema_pass_rate", "error_rate", "gate_pass_rate"],
      "primary_metric": "composite",
      "weight": 1.5,
      "formula": "0.30*(1-guardrail_rate) + 0.25*schema_pass_rate + 0.25*gate_pass_rate + 0.20*(1-error_rate)",
      "description": "Refusals, schema conformance, errors, gate passage across all components"
    },
    {
      "id": 10,
      "name": "Cost Efficiency",
      "key": "10_cost",
      "components": ["_all"],
      "grading_track": "computed",
      "primary_artifacts": [],
      "metrics": ["full_run_cost_usd", "cost_per_component"],
      "primary_metric": "full_run_cost_usd",
      "weight": 0.5,
      "scoring_note": "Inverse rank — lowest cost wins. Score = min_cost_across_models / this_model_cost",
      "description": "Total run cost from tokens x user-provided pricing"
    },
    {
      "id": 11,
      "name": "Reproducibility",
      "key": "11_reproducibility",
      "components": ["_all"],
      "grading_track": "computed",
      "primary_artifacts": [],
      "metrics": ["jaccard_findings", "cv_finding_count", "cv_cost"],
      "primary_metric": "composite",
      "weight": 1.0,
      "formula": "0.50*jaccard_findings + 0.30*(1-cv_finding_count) + 0.20*(1-cv_cost)",
      "description": "Finding overlap and cost consistency across 3 repeats"
    }
  ]
}
