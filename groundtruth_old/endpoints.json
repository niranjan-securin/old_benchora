  "sources": [
    "SAST endpoint inventory — Samuel Joseph, 2026-08-26",
    "DAST attack surface (29 routes, 53 parameters) — ramesh.gunnam@securin.io, 2026-09-03"
  ],
  "endpoint_count": 31,
  "preconditions": "POST /api/auth/signup/ is unauthenticated and issues a working JWT, so every route marked auth_required is reachable by an anonymous attacker after one request. Treat roles [admin, user, nurse] as 'any authenticated' == 'effectively public' when scoring reachability.",
  "notes": {
    "excluded_deliberately": [
      "GET /media/lab_results/{id}/{file} — the concrete shape observed live. NOT added as a row: the existing GET /media/{path} entry already builds the ('GET','/media') prefix matcher that credits it, whereas a specific row keys to 'GET /media/lab-results/{id}/{id}', which no crawler output normalises to and would be a permanent false negative. Recorded in that row's description instead.",
      "POST /api/auth/token/refresh/ — returns 404; the route was never registered. The endpoint scorer discards 404-only endpoints, so a row here can never be credited. It is a missing route, not a route, and is recorded in vulns.json as L-04.",
      "GET /admin/{app}/{model}/ as a template — normalises to 'GET /admin/{id}/{id}' and never matches crawler output. Added as the two concrete model paths instead."
    ],
    "roles": "unauth = no token; admin/user/nurse = any authenticated (self-registerable); staff = Django staff flag, additionally gated by per-model permissions.",
    "parameter_locations": "query | body (JSON) | path | multipart",
    "exploited_flag": "parameters[].exploited marks the parameter an advisory actually abused."
  }
}
